{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noBarrelFile": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*"],
                "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/components/*/index.ts", "src/shared/lib/utils.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/features/*/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": ["**/server/**"],
                    "message": "components/ nie importuje server/. Dane dostaje przez propsy (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/utils/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": ["**/server/**", "**/components/**"],
                    "message": "utils/ nie importuje server/ ani components/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/model/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": [
                      "**/server/**",
                      "**/components/**",
                      "**/utils/**"
                    ],
                    "message": "model/ importuje tylko zod i inne pliki z model/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/*/server/sources/**",
        "src/features/*/server/mappers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": ["**/repositories/**", "**/services/**"],
                    "message": "sources/ i mappers/ nie importują repositories/ ani services/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/server/repositories/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": ["**/services/**"],
                    "message": "repositories/ nie importuje services/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**"],
                    "message": "shared/ nie importuje niczego z features/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
