{
  "name": "linker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local up -d",
    "db:down": "docker compose --env-file .env.local down",
    "db:generate": "drizzle-kit generate --config src/database/config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/database/config/drizzle.config.ts",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "returns:seed": "tsx --conditions=react-server scripts/seed-returns.ts",
    "returns:import-demo": "tsx --conditions=react-server scripts/import-demo-returns.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-table": "^9.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "barcode-detector": "^3.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@inquirer/prompts": "^8.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  }
}
